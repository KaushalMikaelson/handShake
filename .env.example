# Copy to .env and fill in as needed.
#
# EVERY value here is optional. With none of them set the system runs
# end-to-end against deterministic local implementations of both Razorpay and
# the LLM - see docs/architecture.md, "Running without credentials".

# --- Razorpay (TEST MODE ONLY - never put live keys here) ---
# Without these, payments use the in-process simulator.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Must match the secret configured on the webhook in the Razorpay dashboard.
RAZORPAY_WEBHOOK_SECRET=demo_webhook_secret

# --- Anthropic ---
# Without this, the agents use their deterministic rule-based path.
# Every guardrail behaves identically either way.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# --- Database ---
# Defaults to local SQLite. docker-compose overrides this with Postgres.
DATABASE_URL=sqlite:///./agent_commerce.db

# --- Misc ---
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
